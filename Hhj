from pyspark.sql import functions as F
from pyspark.sql.window import Window

# 1. filter lineitems where receiptdate > commitdate
late_items_df = (
    lineitem_df
    .filter(F.col("l_receiptdate") > F.col("l_commitdate"))
    .select("l_orderkey")
    .distinct()
)

# 2. compute average totalprice per order priority
priority_avg_df = (
    orders_df
    .groupBy("o_orderpriority")
    .agg(F.avg("o_totalprice").alias("avg_totalprice"))
)

# 3. join everything and filter
result_df = (
    orders_df
    .join(late_items_df, orders_df.o_orderkey == late_items_df.l_orderkey)
    .join(priority_avg_df, "o_orderpriority")
    .filter(F.col("o_totalprice") > F.col("avg_totalprice"))
    .select("o_orderkey", "o_orderdate", "o_totalprice")
    .distinct()
)

result_df.show(truncate=False)

