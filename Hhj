from pyspark.sql import functions as F
from pyspark.sql.window import Window

# 1. Find first order date per customer
first_order_df = (
    orders_df
    .withColumn(
        "order_rank",
        F.row_number().over(
            Window.partitionBy("o_custkey").orderBy("o_orderdate")
        )
    )
    .filter(F.col("order_rank") == 1)
    .select("o_custkey", "o_orderkey", "o_orderdate")
)

# 2. Check first order has at least one lineitem with shipmode = 'AIR'
air_ship_df = (
    lineitem_df
    .filter(F.col("l_shipmode") == "AIR")
    .select("l_orderkey")
    .distinct()
)

# 3. Join and return customers whose first order shipped by AIR
result_df = (
    first_order_df
    .join(air_ship_df, first_order_df.o_orderkey == air_ship_df.l_orderkey)
    .join(customer_df.select("c_custkey", "c_name"), "o_custkey")
    .select("c_name", "o_orderdate")
)

result_df.show(truncate=False)
