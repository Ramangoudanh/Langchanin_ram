from pyspark.sql import functions as F
from pyspark.sql.window import Window

# 1. Compute revenue per order line
line_revenue_df = (
    lineitem_df
    .withColumn("revenue", F.col("EXTENDEDPRICE") * (1 - F.col("DISCOUNT")))
    .groupBy("ORDERKEY")
    .agg(F.sum("revenue").alias("order_revenue"))
)

# 2. Compute total revenue per customer
cust_revenue_df = (
    orders_df
    .join(line_revenue_df, "ORDERKEY")
    .groupBy("CUSTKEY")
    .agg(F.sum("order_revenue").alias("total_revenue"))
)

# 3. Join CUSTOMER → NATION → REGION to get region for each customer
cust_region_df = (
    cust_revenue_df
    .join(customer_df.select("CUSTKEY", "NATIONKEY"), "CUSTKEY")
    .join(nation_df.select("NATIONKEY", "REGIONKEY"), "NATIONKEY")
    .join(region_df.select("REGIONKEY", "NAME"), "REGIONKEY")
    .withColumnRenamed("NAME", "REGION_NAME")
)

# 4. Calculate percentile rank per region
window = Window.partitionBy("REGION_NAME").orderBy(F.col("total_revenue"))

result_df = (
    cust_region_df
    .withColumn("percentile_rank", F.percent_rank().over(window))
    .orderBy("REGION_NAME", "percentile_rank")
)

result_df.show(truncate=False)
