from langchain.output_parsers import StructuredOutputParser, ResponseSchema

report_schema = [
    ResponseSchema(name="title", description="Title of the research report"),
    ResponseSchema(name="abstract", description="Concise abstract or executive summary"),
    ResponseSchema(name="introduction", description="Research introduction"),
    ResponseSchema(name="methodology", description="Methodology summary"),
    ResponseSchema(name="findings", description="List of findings and validated answers"),
    ResponseSchema(name="discussion", description="Analytical discussion of results"),
    ResponseSchema(name="conclusion", description="Overall conclusion"),
    ResponseSchema(name="citations", description="List of references"),
    ResponseSchema(name="meta", description="Meta info like confidence and generation time")
]

report_output_parser = StructuredOutputParser.from_response_schemas(report_schema)
report_format_instructions = report_output_parser.get_format_instructions()


import json
from datetime import datetime

@agent1.node("node5", prompt="Final report synthesis with structured output parser")
def node5_report_assembly(state: ResearchCoordinatorState) -> ResearchCoordinatorState:
    """
    Node 5 – Uses Agent 5 (OutputFormattingAgent) to generate a fully structured report.
    """

    print("\n📘 [Agent 1 – Node 5] Assembling final structured report...")

    completed_subs = [s for s in state.sub_queries if s.status == "completed"]
    if not completed_subs:
        print("⚠️ No completed sub-queries found; cannot assemble report.")
        state.next_node = None
        return state

    # Prepare validated results payload
    validated_results = [
        {
            "question": s.text,
            "verified_summary": s.answer,
            "sources_used": s.sources or [],
            "confidence": s.confidence or 0.8
        }
        for s in completed_subs
    ]

    # Build instruction for Agent 5
    llm_input = f"""
    You are the OutputFormattingAgent. Using the following validated results,
    produce the final structured report according to the required schema below.

    SCHEMA:
    {report_format_instructions}

    USER QUERY: {state.user_query}

    VALIDATED RESULTS:
    {json.dumps(validated_results, indent=2)}
    """

    # 🔹 Call Agent 5 with Structured Output Parser
    response = agent5.llm.invoke(llm_input)
    parsed_output = report_output_parser.parse(response.content)

    # 🔹 Save parsed report in state
    state.final_report = parsed_output
    state.workflow_status = "completed"
    state.overall_progress_pct = 100.0
    state.last_updated = datetime.utcnow()
    state.next_node = None

    print("✅ Final structured report generated and parsed successfully.")
    return state
