from pyspark.sql import functions as F
from pyspark.sql.window import Window

# Load TPCH tables (adjust catalog/db names if needed)
orders_df = spark.table("tpch.orders")
lineitem_df = spark.table("tpch.lineitem")

# Join orders with lineitem to map customers to suppliers
cust_supp_df = (
    orders_df.join(lineitem_df, "orderkey")
    .select("custkey", "suppkey")
)

# Count how many times each supplier appears per customer
cust_supp_freq = (
    cust_supp_df.groupBy("custkey", "suppkey")
    .agg(F.count("*").alias("frequency"))
)

# Window spec to pick the top supplier per customer
window_spec = Window.partitionBy("custkey").orderBy(F.desc("frequency"))

result_df = (
    cust_supp_freq
    .withColumn("rank", F.row_number().over(window_spec))
    .filter("rank = 1")
    .select("custkey", "suppkey", "frequency")
    .orderBy("custkey")
)

display(result_df)
