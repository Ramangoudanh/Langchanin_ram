from pydantic import BaseModel, Field
from typing import List, Optional, Dict, Any
from datetime import datetime

class SubQueryRecord(BaseModel):
    id: int
    text: str                        # the sub-query itself
    priority: int                    # lower = run earlier
    status: str = "pending"          # pending | running | completed | failed
    routed_path: Optional[List[str]] = None   # e.g. ["node2","node4"] or ["node3","node4"]
    answer: Optional[str] = None
    sources: Optional[List[Dict[str, Any]]] = None
      # each source: { "url": "...", "title": "...", "last_updated": "...", "credibility_score": 0.85 }
    confidence: Optional[float] = None
    notes: Optional[str] = None      # e.g. "LLM-derived due to weak evidence"
    started_at: Optional[datetime] = None
    finished_at: Optional[datetime] = None

class ResearchCoordinatorState(BaseModel):
    user_query: str
    sub_queries: List[SubQueryRecord] = []
    next_subquery_id: Optional[int] = None
    overall_progress_pct: float = 0.0   # computed from sub_queries statuses
    remaining_subqueries: int = 0       # convenience field
    created_at: datetime = Field(default_factory=datetime.utcnow)
    last_updated: datetime = Field(default_factory=datetime.utcnow)
    final_report: Optional[str] = None
    workflow_status: str = "in-progress"  # in-progress | completed | failed
