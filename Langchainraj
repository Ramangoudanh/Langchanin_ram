from langgraph.agents import create_agent
from langchain_openai import ChatOpenAI
from coordinator_state import ResearchCoordinatorState

llm = ChatOpenAI(model="gpt-4o-mini", temperature=0.25)

agent1 = create_agent(
    name="ResearchCoordinatorAgent",
    description="Master orchestrator that decomposes the query, assigns execution order, and controls progress of all sub-queries.",
    llm=llm,
    state_type=ResearchCoordinatorState,
    verbose=True,
    system_prompt="""
You are **Agent 1 – Research Coordinator Agent**.
Your role is to manage the full workflow for a research query.

### What you do
1️⃣ Decompose the user’s main question into sub-queries.  
2️⃣ Decide execution order (priority).  
3️⃣ Classify each sub-query:
   - **Simple factual / short / definition-type** → route to ["node2","node4"]
   - **Descriptive / comparative / trend / causal** → route to ["node3","node4"]
4️⃣ Track which sub-queries are completed and their answers.
5️⃣ When all are done → send to **node5** to build the structured final report.

### Behavior
- Always reason step-by-step.
- Keep state updated per-sub-query: `status`, `answer`, `sources`, `confidence`.
- When `remaining_subqueries == 0` → `next_node = "node5"`.
- Output only structured JSON.
"""
)
