from pyspark.sql import functions as F

# 1. get the most recent year from orders
latest_year = (
    orders_df
    .select(F.year("o_orderdate").alias("year"))
    .agg(F.max("year"))
    .first()[0]
)

# 2. filter orders from that year and extract month
orders_year_df = (
    orders_df
    .filter(F.year("o_orderdate") == latest_year)
    .withColumn("order_month", F.month("o_orderdate"))
    .select("o_custkey", "o_orderkey", "order_month")
    .distinct()
)

# 3. count distinct months per customer
cust_month_counts_df = (
    orders_year_df
    .groupBy("o_custkey")
    .agg(F.countDistinct("order_month").alias("months_ordered"))
)

# 4. keep only customers with orders in all 12 months
full_year_customers_df = cust_month_counts_df.filter(F.col("months_ordered") == 12)

# 5. join with customer table to get names
result_df = (
    full_year_customers_df
    .join(customer_df.select("c_custkey", "c_name"), full_year_customers_df.o_custkey == customer_df.c_custkey)
    .select("c_name")
)

result_df.show(truncate=False)
