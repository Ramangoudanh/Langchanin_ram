from pyspark.sql import functions as F

# 1. compute discounted revenue per lineitem
line_revenue_df = (
    lineitem_df
    .withColumn("revenue", F.col("l_extendedprice") * (1 - F.col("l_discount")))
    .select("l_orderkey", "l_suppkey", "revenue")
)

# 2. join orders to get customer for each order
order_customer_df = orders_df.select("o_orderkey", "o_custkey")

# 3. join lineitem + orders to connect supplier <-> customer
supplier_customer_revenue_df = (
    line_revenue_df
    .join(order_customer_df, "l_orderkey")
    .groupBy("l_suppkey", "o_custkey")
    .agg(F.sum("revenue").alias("total_transaction_value"))
)

# 4. get top 10 supplier-customer pairs by revenue
top10_df = (
    supplier_customer_revenue_df
    .orderBy(F.col("total_transaction_value").desc())
    .limit(10)
    .select("l_suppkey", "o_custkey", "total_transaction_value")
)

top10_df.show(truncate=False)
