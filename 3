from pyspark.sql import functions as F
from pyspark.sql.window import Window

# Window per customer ordered by orderdate ascending (earliest first)
w_asc = Window.partitionBy("o_custkey").orderBy("o_orderdate")

# Window per customer ordered by orderdate descending (latest first)
w_desc = Window.partitionBy("o_custkey").orderBy(F.col("o_orderdate").desc())

# Add ranking to find earliest & latest orders
ranked_orders_df = (
    orders_df
    .withColumn("rn_earliest", F.row_number().over(w_asc))
    .withColumn("rn_latest", F.row_number().over(w_desc))
)

# Extract earliest orders
earliest_df = (
    ranked_orders_df
    .filter(F.col("rn_earliest") == 1)
    .select(
        "o_custkey",
        F.col("o_orderdate").alias("earliest_orderdate"),
        F.col("o_totalprice").alias("earliest_orderprice")
    )
)

# Extract latest orders
latest_df = (
    ranked_orders_df
    .filter(F.col("rn_latest") == 1)
    .select(
        "o_custkey",
        F.col("o_orderdate").alias("latest_orderdate"),
        F.col("o_totalprice").alias("latest_orderprice")
    )
)

# Join earliest + latest + customer name
result_df = (
    earliest_df
    .join(latest_df, "o_custkey")
    .join(customer_df.select("c_custkey", "c_name"), earliest_df.o_custkey == customer_df.c_custkey)
    .select("c_name", "earliest_orderdate", "earliest_orderprice", "latest_orderdate", "latest_orderprice")
)

result_df.show(truncate=False)
