from pyspark.sql import functions as F

# 1. find parts that appear under at least 2 different brands
multi_brand_parts_df = (
    part_df
    .groupBy("p_partkey")
    .agg(F.countDistinct("p_brand").alias("brand_count"))
    .filter(F.col("brand_count") >= 2)
    .select("p_partkey")
)

# 2. join with lineitem to compute discounted revenue only for valid parts
discounted_revenue_df = (
    lineitem_df
    .join(multi_brand_parts_df, "l_partkey")
    .withColumn("discounted_revenue", F.col("l_extendedprice") * (1 - F.col("l_discount")))
)

# 3. sum revenue per supplier
supplier_revenue_df = (
    discounted_revenue_df
    .groupBy("l_suppkey")
    .agg(F.sum("discounted_revenue").alias("total_discounted_revenue"))
)

# 4. join supplier table (optional, if name required)
result_df = (
    supplier_revenue_df
    .join(supplier_df.select("s_suppkey", "s_name"), supplier_revenue_df.l_suppkey == supplier_df.s_suppkey)
    .select("s_suppkey", "s_name", "total_discounted_revenue")
)

result_df.show(truncate=False)
