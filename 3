from pyspark.sql import functions as F
from pyspark.sql.window import Window

# 1. For each supplier, rank lineitems by extendedprice (largest first)
window = Window.partitionBy("l_suppkey").orderBy(F.col("l_extendedprice").desc())

ranked_sales_df = (
    lineitem_df
    .withColumn("rank", F.row_number().over(window))
)

# 2. Keep only highest sale per supplier
largest_sale_df = (
    ranked_sales_df
    .filter(F.col("rank") == 1)
    .select("l_suppkey", "l_orderkey", "l_linenumber", "l_extendedprice")
)

# 3. Join with supplier table to get supplier details if needed
result_df = (
    largest_sale_df
    .join(supplier_df.select("s_suppkey", "s_name"), largest_sale_df.l_suppkey == supplier_df.s_suppkey)
    .select("s_suppkey", "s_name", "l_orderkey", "l_linenumber", "l_extendedprice")
)

result_df.show(truncate=False)
